{% comment %}
  ==============================================================================
  Live Shopping Assistant — Shopify Theme Snippet
  
  Copy to: snippets/shopping-agent.liquid
  Then in theme.liquid before </body> add:
    {% render 'shopping-agent' %}
  ==============================================================================
{% endcomment %}

<div 
  id="live-commerce-root"
  data-backend-url="{{ backend_url | default: 'https://ttk.facetimefy.com' }}"
  data-shop-domain="{{ shop.permanent_domain }}"
></div>

{{ 'shopping-agent.css' | asset_url | stylesheet_tag }}
<script src="{{ 'shopping-agent.js' | asset_url }}" defer></script>
